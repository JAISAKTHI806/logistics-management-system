# Local development uses SQLite when DATABASE_URL is omitted.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=

# For a Vercel demo, configure these in Vercel Project Settings instead.
SEED_DEMO_DATA=true
DEMO_ADMIN_PASSWORD=replace-with-a-unique-password
DEMO_CUSTOMER_PASSWORD=replace-with-a-unique-password
DEMO_DISPATCHER_PASSWORD=replace-with-a-unique-password
DEMO_AGENT_PASSWORD=replace-with-a-unique-password
DEMO_WAREHOUSE_PASSWORD=replace-with-a-unique-password
